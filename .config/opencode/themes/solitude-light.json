{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#e8ebee",
    "bgDark": "#dde0e4",
    "bgDarker": "#d3d6da",
    "bgLight": "#f0f2f4",
    "fg": "#2c3135",
    "fgDark": "#1a1e21",
    "fgLight": "#4a5055",
    "fgBright": "#5c6369",
    "muted": "#8a9199",
    "accent": "#5a6370",
    "selection": "#d0d7dc",
    "red": "#8a6050",
    "yellow": "#7a7560",
    "green": "#5a7060",
    "cyan": "#607070",
    "blue": "#506878",
    "magenta": "#706070",
    "brightRed": "#b84535",
    "brightYellow": "#8a7a55",
    "brightGreen": "#3a6050",
    "brightCyan": "#457070",
    "brightBlue": "#3a5868",
    "brightMagenta": "#704060"
  },
  "theme": {
    "primary": {
      "dark": "blue",
      "light": "blue"
    },
    "secondary": {
      "dark": "accent",
      "light": "accent"
    },
    "accent": {
      "dark": "cyan",
      "light": "cyan"
    },
    "error": {
      "dark": "brightRed",
      "light": "brightRed"
    },
    "warning": {
      "dark": "brightYellow",
      "light": "brightYellow"
    },
    "success": {
      "dark": "brightGreen",
      "light": "brightGreen"
    },
    "info": {
      "dark": "brightCyan",
      "light": "brightCyan"
    },
    "text": {
      "dark": "fg",
      "light": "fg"
    },
    "textMuted": {
      "dark": "muted",
      "light": "muted"
    },
    "background": {
      "dark": "bg",
      "light": "bg"
    },
    "backgroundPanel": {
      "dark": "bgDark",
      "light": "bgDark"
    },
    "backgroundElement": {
      "dark": "bgDarker",
      "light": "bgDarker"
    },
    "border": {
      "dark": "bgDarker",
      "light": "bgDarker"
    },
    "borderActive": {
      "dark": "accent",
      "light": "accent"
    },
    "borderSubtle": {
      "dark": "selection",
      "light": "selection"
    },
    "diffAdded": {
      "dark": "brightGreen",
      "light": "brightGreen"
    },
    "diffRemoved": {
      "dark": "brightRed",
      "light": "brightRed"
    },
    "diffContext": {
      "dark": "muted",
      "light": "muted"
    },
    "diffHunkHeader": {
      "dark": "muted",
      "light": "muted"
    },
    "diffHighlightAdded": {
      "dark": "green",
      "light": "green"
    },
    "diffHighlightRemoved": {
      "dark": "red",
      "light": "red"
    },
    "diffAddedBg": {
      "dark": "bgLight",
      "light": "bgLight"
    },
    "diffRemovedBg": {
      "dark": "bgDark",
      "light": "bgDark"
    },
    "diffContextBg": {
      "dark": "bg",
      "light": "bg"
    },
    "diffLineNumber": {
      "dark": "muted",
      "light": "muted"
    },
    "diffAddedLineNumberBg": {
      "dark": "bgLight",
      "light": "bgLight"
    },
    "diffRemovedLineNumberBg": {
      "dark": "bgDark",
      "light": "bgDark"
    },
    "markdownText": {
      "dark": "fg",
      "light": "fg"
    },
    "markdownHeading": {
      "dark": "blue",
      "light": "blue"
    },
    "markdownLink": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownLinkText": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownCode": {
      "dark": "green",
      "light": "green"
    },
    "markdownBlockQuote": {
      "dark": "muted",
      "light": "muted"
    },
    "markdownEmph": {
      "dark": "magenta",
      "light": "magenta"
    },
    "markdownStrong": {
      "dark": "brightMagenta",
      "light": "brightMagenta"
    },
    "markdownHorizontalRule": {
      "dark": "bgDarker",
      "light": "bgDarker"
    },
    "markdownListItem": {
      "dark": "blue",
      "light": "blue"
    },
    "markdownListEnumeration": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownImage": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownImageText": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownCodeBlock": {
      "dark": "fg",
      "light": "fg"
    },
    "syntaxComment": {
      "dark": "muted",
      "light": "muted"
    },
    "syntaxKeyword": {
      "dark": "blue",
      "light": "blue"
    },
    "syntaxFunction": {
      "dark": "green",
      "light": "green"
    },
    "syntaxVariable": {
      "dark": "cyan",
      "light": "cyan"
    },
    "syntaxString": {
      "dark": "yellow",
      "light": "yellow"
    },
    "syntaxNumber": {
      "dark": "magenta",
      "light": "magenta"
    },
    "syntaxType": {
      "dark": "cyan",
      "light": "cyan"
    },
    "syntaxOperator": {
      "dark": "blue",
      "light": "blue"
    },
    "syntaxPunctuation": {
      "dark": "fg",
      "light": "fg"
    }
  }
}
